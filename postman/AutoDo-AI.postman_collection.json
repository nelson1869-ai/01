                  "    pm.expect(json.data).to.have.property(\"telemetry\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"message\": \"What should I work on next?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assistant", "chat"]
            },
            "description": "Uses bounded durable context from the preceding verified turn."
          },
          "response": []
        },
        {
