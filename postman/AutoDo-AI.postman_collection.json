    {
      "name": "M8.7 Conversational Assistant",
      "item": [
        {
          "name": "New Conversation (Direct Answer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Assistant response is a valid handled outcome\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    var allowedStatuses = [\"COMPLETED\", \"CLARIFICATION_REQUIRED\", \"DENIED\", \"FAILED\", \"UNVERIFIED\"];",
                  "    var safeProviderStatuses = [\"READY\", \"MISSING_CREDENTIAL\", \"AUTHENTICATION_FAILED\", \"RATE_LIMITED\", \"TIMEOUT\", \"PROVIDER_UNAVAILABLE\", \"SAFETY_BLOCKED\", \"INVALID_STRUCTURED_OUTPUT\", \"RESPONSE_TOO_LARGE\", \"UNKNOWN_PROVIDER_FAILURE\"];",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json.data).to.have.property(\"status\");",
                  "    pm.expect(allowedStatuses).to.include(json.data.status);",
                  "    pm.expect(json.data.conversationId).to.match(/^conv-/);",
                  "    pm.expect(json.data.message).to.be.a(\"string\");",
                  "    pm.expect(json.data).to.have.property(\"telemetry\");",
                  "    pm.expect(json.data.telemetry).to.have.property(\"totalDurationMs\");",
                  "    pm.expect(json.data.telemetry).to.have.property(\"ai\");",
                  "    if (json.data.status === \"FAILED\") {",
                  "        pm.expect(json.data).to.have.property(\"providerStatus\");",
                  "        pm.expect(safeProviderStatuses).to.include(json.data.providerStatus);",
                  "    }",
                  "    if (json.data.status === \"COMPLETED\") {",
                  "        pm.expect(json.data.message.trim().length).to.be.above(0);",
                  "    }",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.conversationId) pm.environment.set(\"conversationId\", json.data.conversationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello AutoDo. What can you do?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assistant/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assistant", "chat"]
            },
            "description": "Starts a durable bounded conversation with a direct answer and returns telemetry."
          },
          "response": []
        },
