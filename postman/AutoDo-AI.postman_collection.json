                  "});",
                  "",
                  "pm.test(\"Cue ID matches requested cueId\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.cue.cueId).to.eql(pm.environment.get(\"cueId\"));",
                  "});"
                ],
