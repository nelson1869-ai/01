          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Repository deletion is denied before execution\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql(\"DENIED\");",
                  "    pm.expect(json.data.sessionId).to.eql(null);",
                  "    pm.expect(json.data.executionId).to.eql(null);",
                  "    pm.expect(json.data.message).to.include(\"read-only GitHub policy\");",
                  "});",
                  "pm.test(\"No credentials or private reasoning are exposed\", function () {",
                  "    pm.expect(pm.response.text()).not.to.match(/AIza|ghp_|github_pat_|chainOfThought|runtimeAuthorization/i);",
                  "});"
