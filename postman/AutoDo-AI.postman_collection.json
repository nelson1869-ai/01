          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tool-backed answer is verified\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql(\"COMPLETED\");",
                  "    pm.expect(json.data.verification).to.eql(\"VERIFIED\");",
                  "    pm.expect(json.data.sessionId).to.match(/^sess-/);",
                  "    pm.expect(json.data.executionId).to.be.a(\"string\");",
                  "    pm.expect(json.data).to.have.property(\"telemetry\");",
                  "    pm.expect(json.data.telemetry.ai.length).to.be.above(0);",
                  "});"
                ]
