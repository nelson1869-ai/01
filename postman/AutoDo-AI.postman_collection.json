    {
      "name": "M8.2 Run Cognitive Cycle",
      "item": [
        {
          "name": "Run Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Result status and session exist\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property(\"result\");",
                  "    pm.expect(json.data.result).to.have.property(\"status\");",
                  "    pm.expect(json.data).to.have.property(\"session\");",
                  "    pm.expect(json.data.session.sessionId).to.eql(pm.environment.get(\"sessionId\"));",
                  "",
                  "    if (json.data.result.executionId) {",
                  "        pm.environment.set(\"executionId\", json.data.result.executionId);",
                  "    }",
                  "    if (json.data.result.verificationId) {",
                  "        pm.environment.set(\"verificationId\", json.data.result.verificationId);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"No runtime authorization or secret leakage in response\", function () {",
                  "    var text = pm.response.text();",
                  "    pm.expect(text).not.to.include(\"runtimeAuthorization\");",
                  "    pm.expect(text).not.to.include(\"AIzaSy\");",
                  "    pm.expect(text).not.to.include(\"ghp_\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskProfile\": \"github-readonly-v1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cognitive/sessions/{{sessionId}}/run",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cognitive", "sessions", "{{sessionId}}", "run"]
            },
            "description": "Drives the autonomous cognitive cycle for the session until a stable boundary."
          },
          "response": []
        }
      ]
