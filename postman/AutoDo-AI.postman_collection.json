    {
      "name": "M8.1 Cue & Sessions",
      "item": [
        {
          "name": "Create Cue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test(\"Save cueId and sessionId into environment\", function () {",
                  "    var json = pm.response.json();",
                  "    if (json && json.data) {",
                  "        if (json.data.cue && json.data.cue.cueId) {",
                  "            pm.environment.set(\"cueId\", json.data.cue.cueId);",
                  "        }",
                  "        if (json.data.session && json.data.session.sessionId) {",
                  "            pm.environment.set(\"sessionId\", json.data.session.sessionId);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-sample-key-1",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"postman\",\n  \"type\": \"user.action\",\n  \"payload\": {\n    \"instruction\": \"Read README.md from repository\"\n  },\n  \"maxRetries\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/cognitive/cues",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cognitive", "cues"]
            },
            "description": "Atomically creates a durable cue and its initial cognitive session (in CUE phase)."
          },
          "response": []
        },
